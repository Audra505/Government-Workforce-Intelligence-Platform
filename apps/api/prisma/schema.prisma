// =============================================================================
// Government Workforce Intelligence Platform — Prisma Schema
// Milestone 2: Database Foundation
// Reference: spec/05_database_schema.md, execution/02_phase_1_foundation.md
// =============================================================================
//
// PostgreSQL schemas declared here (Milestone 2 scope):
//   organization — tenants (multi-tenant root; spec: organization.agencies)
//   identity     — users, roles, permissions, role_permissions, user_roles
//   audit        — audit_events (immutable audit trail)
//
// Future schemas added progressively as domains are implemented:
//   workforce, scheduling, recruiting, intelligence, compliance, integration
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "organization", "audit", "workforce", "recruiting", "intelligence", "decisions"]
}

// ---------------------------------------------------------------------------
// Schema: organization
// Tenant root entity. Every tenant-scoped table carries tenant_id UUID
// referencing this table.
// Spec reference: spec/05_database_schema.md — Schema: organization / agencies
// The platform treats agency and tenant as the same concept at the DB level.
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  code      String   @unique @db.VarChar(100)
  status    String   @default("ACTIVE") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users       User[]
  departments Department[]

  @@map("tenants")
  @@schema("organization")
}

// ---------------------------------------------------------------------------
// Schema: organization — Department
// Spec reference: spec/05_database_schema.md — Schema: organization / departments
// Approved decisions:
//   - code VARCHAR(100) with tenant-scoped unique constraint (Decision 2)
//   - deleted_at per platform soft-delete convention (Decision 3)
//   - agencyId column omitted: Tenant IS Agency (ORG-006); tenantId serves both
//     tenant isolation and agency association roles — adding a separate agencyId
//     FK to the same Tenant row would be redundant.
// ---------------------------------------------------------------------------

model Department {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(255)
  code        String    @db.VarChar(100)
  description String?   @db.Text
  status      String    @default("ACTIVE") @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant                  Tenant             @relation(fields: [tenantId], references: [id])
  positions               Position[]
  employees               Employee[]
  // GD-M38-1 Decision 15: ElevationSession.scopeDepartmentId is a real,
  // restrictive FK into this table for DEPARTMENT-scoped elevation.
  // Additive back-relation only — no other field on this model is touched.
  scopedElevationSessions ElevationSession[]

  @@unique([tenantId, code], map: "idx_departments_tenant_code")
  @@index([tenantId], map: "idx_departments_tenant")
  @@map("departments")
  @@schema("organization")
}

// ---------------------------------------------------------------------------
// Schema: workforce
// Spec reference: spec/05_database_schema.md — Schema: workforce / positions
// Milestone 8: Position Management Foundation (FR-100)
// Approved decisions:
//   - status default DRAFT per full 4-state lifecycle (Decision 1: DRAFT/ACTIVE/FROZEN/CLOSED)
//   - tenantId as bare scalar (no Prisma relation to Tenant) — isolation enforced at query level
//   - departmentId FK to organization.departments — cross-schema relation (multiSchema preview)
//   - deleted_at per platform soft-delete convention
//   - skills/certifications deferred (Decision 3)
// ---------------------------------------------------------------------------

model Position {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  departmentId   String    @map("department_id") @db.Uuid
  title          String    @db.VarChar(255)
  classification String?   @db.VarChar(100)
  salaryBand     String?   @map("salary_band") @db.VarChar(100)
  status         String    @default("DRAFT") @db.VarChar(50)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  department Department @relation(fields: [departmentId], references: [id])
  vacancies  Vacancy[]
  employees  Employee[]

  @@index([tenantId], map: "idx_positions_tenant")
  @@index([departmentId], map: "idx_positions_department")
  @@map("positions")
  @@schema("workforce")
}

// ---------------------------------------------------------------------------
// Schema: workforce — Vacancy
// Spec reference: spec/05_database_schema.md — Schema: workforce / vacancies
// Milestone 11: Vacancy Management (FR-103, FR-104)
// Approved governance decisions:
//   - status/priority/reason stored as VARCHAR per platform convention (no Prisma enums)
//   - tenantId as bare scalar (no FK to Tenant) — isolation enforced at query level
//   - filledAt added (not in spec/05): required for Time To Fill metric (directives/03 Reporting Rules)
//   - deleted_at per platform soft-delete convention
//   - 4 indexes: position, status, tenant, createdAt (last two governance additions to spec/05 gaps)
// ---------------------------------------------------------------------------

model Vacancy {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  positionId       String    @map("position_id") @db.Uuid
  priority         String?   @db.VarChar(50)
  reason           String?   @db.VarChar(100)
  status           String    @default("DRAFT") @db.VarChar(50)
  expectedFillDate DateTime? @map("expected_fill_date") @db.Date
  filledAt         DateTime? @map("filled_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  position     Position      @relation(fields: [positionId], references: [id], map: "fk_vacancy_position")
  applications Application[]

  @@index([tenantId], map: "idx_vacancies_tenant")
  @@index([positionId], map: "idx_vacancies_position")
  @@index([status], map: "idx_vacancies_status")
  @@index([createdAt], map: "idx_vacancies_created")
  @@map("vacancies")
  @@schema("workforce")
}

// ---------------------------------------------------------------------------
// Schema: workforce — Employee
// Spec reference: spec/05_database_schema.md — Schema: workforce / employees
// Milestone 12: Employee Management Foundation (FR-110, FR-111, FR-112)
// Milestone 15: Position Linkage (GD-M15-1)
// Approved governance decisions:
//   - employmentStatus @default("PENDING_ONBOARDING") per GD-M12-1 canonical values
//   - employmentStatus stored as VARCHAR per platform convention (no Prisma enum)
//   - tenantId as bare scalar (no FK to Tenant) — isolation enforced at query level (SEC-003)
//   - departmentId FK to organization.departments — cross-schema relation (multiSchema preview)
//   - employeeNumber nullable at DB level per spec/05; required at API level per GD-M12-6
//   - employeeNumber immutable after creation per GD-M12-6 (enforced at service layer)
//   - positionId: UUID NULL FK → workforce.positions (GD-M15-1 D2; GD-PRE-M13-002 D1)
//     No DB unique constraint — 1:1 FTE Slot Model enforced at service layer only
//     Partial index (WHERE NOT NULL) in migration SQL; @@index here is the Prisma representation
//   - appointmentAuthority: VARCHAR(50) NOT NULL (GD-M15-1 D1); backfilled ADMINISTRATIVE
//     for pre-M15 records per GD-M15-1 D3; immutable after creation (GD-PRE-M13-001 D4)
//   - deleted_at per platform soft-delete convention
// ---------------------------------------------------------------------------

model Employee {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  departmentId         String    @map("department_id") @db.Uuid
  positionId           String?   @map("position_id") @db.Uuid
  employeeNumber       String?   @map("employee_number") @db.VarChar(100)
  firstName            String    @map("first_name") @db.VarChar(100)
  lastName             String    @map("last_name") @db.VarChar(100)
  email                String?   @db.VarChar(255)
  employmentStatus     String    @default("PENDING_ONBOARDING") @map("employment_status") @db.VarChar(50)
  appointmentAuthority String    @map("appointment_authority") @db.VarChar(50)
  hireDate             DateTime? @map("hire_date") @db.Date
  terminationDate      DateTime? @map("termination_date") @db.Date
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)

  department Department @relation(fields: [departmentId], references: [id])
  position   Position?  @relation(fields: [positionId], references: [id], map: "fk_employee_position")

  employeeSkills         EmployeeSkill[]
  employeeCertifications EmployeeCertification[]

  @@unique([tenantId, employeeNumber], map: "idx_employee_number_tenant")
  @@index([tenantId], map: "idx_employees_tenant")
  @@index([positionId], map: "idx_employees_position")
  @@map("employees")
  @@schema("workforce")
}

// ---------------------------------------------------------------------------
// Schema: workforce — Skill
// Spec reference: spec/05_database_schema.md — Schema: workforce / skills
// Milestone 13: Skills & Certifications Foundation (FR-113, FR-150)
// Governance decisions:
//   - tenant_id per GD-M13-1 Decision 2 (spec deviation — correction of spec oversight)
//   - created_at, updated_at, deleted_at per GD-M13-1 Decision 7 (shared column confirmation)
//   - tenant-scoped unique constraint on name per GD-M13-2 Decision 8
//   - tenantId as bare scalar (no FK to Tenant) — isolation enforced at query level (SEC-003)
// ---------------------------------------------------------------------------

model Skill {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(255)
  category    String?   @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  employeeSkills EmployeeSkill[]

  @@unique([tenantId, name], map: "idx_skills_tenant_name")
  @@index([tenantId], map: "idx_skills_tenant")
  @@map("skills")
  @@schema("workforce")
}

// ---------------------------------------------------------------------------
// Schema: workforce — Certification
// Spec reference: spec/05_database_schema.md — Schema: workforce / certifications
// Milestone 13: Skills & Certifications Foundation (FR-114, FR-151, FR-153)
// Governance decisions:
//   - tenant_id per GD-M13-1 Decision 2 (spec deviation — correction of spec oversight)
//   - created_at, updated_at, deleted_at per GD-M13-1 Decision 7 (shared column confirmation)
//   - tenant-scoped unique constraint on name per GD-M13-2 Decision 9
//   - tenantId as bare scalar (no FK to Tenant) — isolation enforced at query level (SEC-003)
// ---------------------------------------------------------------------------

model Certification {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  name               String    @db.VarChar(255)
  issuer             String?   @db.VarChar(255)
  expirationRequired Boolean   @default(false) @map("expiration_required")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  employeeCertifications EmployeeCertification[]

  @@unique([tenantId, name], map: "idx_certifications_tenant_name")
  @@index([tenantId], map: "idx_certifications_tenant")
  @@map("certifications")
  @@schema("workforce")
}

// ---------------------------------------------------------------------------
// Schema: workforce — EmployeeSkill
// Spec reference: spec/05_database_schema.md — Schema: workforce / employee_skills
// Milestone 13: Skills & Certifications Foundation (FR-113, FR-150)
// Governance decisions:
//   - Composite PK (employee_id, skill_id) per spec/05 and GD-M13-4 Decision 2
//   - proficiency_level: one of BEGINNER/DEVELOPING/PROFICIENT/ADVANCED/EXPERT
//     (GD-M13-2 Decision 6, directives/14 SKL-210); validated at service layer
//   - verified_at null = self-declared; set = HR-verified (directives/14 SKL-211)
//   - No tenant_id column — isolation derived through employee FK chain (GD-M13-1 Decision 7)
// ---------------------------------------------------------------------------

model EmployeeSkill {
  employeeId       String    @map("employee_id") @db.Uuid
  skillId          String    @map("skill_id") @db.Uuid
  proficiencyLevel String?   @map("proficiency_level") @db.VarChar(50)
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id])
  skill    Skill    @relation(fields: [skillId], references: [id])

  @@id([employeeId, skillId])
  @@index([employeeId], map: "idx_employee_skills_employee")
  @@index([skillId], map: "idx_employee_skills_skill")
  @@map("employee_skills")
  @@schema("workforce")
}

// ---------------------------------------------------------------------------
// Schema: workforce — EmployeeCertification
// Spec reference: spec/05_database_schema.md — Schema: workforce / employee_certifications
// Milestone 13: Skills & Certifications Foundation (FR-114, FR-151, FR-153)
// Governance decisions:
//   - Composite PK (employee_id, certification_id) per spec/05 and GD-M13-4 Decision 2
//   - status VARCHAR(50); canonical values: ACTIVE, EXPIRED, REVOKED (GD-M13-3)
//   - status DEFAULT "ACTIVE" per GD-M13-3 Decision 2
//   - REVOKED is terminal; transition enforcement at service layer (CRT-301)
//   - issue_date and expiration_date stored as DATE per spec/05
//   - No tenant_id column — isolation derived through employee FK chain (GD-M13-1 Decision 7)
//   - expirationDate index: supports FR-153 expiration tracking queries (GD-M13-3 Decision 4)
// ---------------------------------------------------------------------------

model EmployeeCertification {
  employeeId      String    @map("employee_id") @db.Uuid
  certificationId String    @map("certification_id") @db.Uuid
  status          String    @default("ACTIVE") @map("status") @db.VarChar(50)
  issueDate       DateTime? @map("issue_date") @db.Date
  expirationDate  DateTime? @map("expiration_date") @db.Date

  employee      Employee      @relation(fields: [employeeId], references: [id])
  certification Certification @relation(fields: [certificationId], references: [id])

  @@id([employeeId, certificationId])
  @@index([employeeId], map: "idx_employee_certifications_employee")
  @@index([certificationId], map: "idx_employee_certifications_certification")
  @@index([status], map: "idx_employee_certifications_status")
  @@index([expirationDate], map: "idx_employee_certifications_expiration")
  @@map("employee_certifications")
  @@schema("workforce")
}

// ---------------------------------------------------------------------------
// Schema: identity
// Spec reference: spec/05_database_schema.md — Schema: identity
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String    @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.Text
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  status              String    @default("INVITED") @db.VarChar(50)
  lastLoginAt         DateTime? @map("last_login_at")         @db.Timestamptz(6)
  failedLoginAttempts Int       @default(0)                   @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")          @db.Timestamptz(6)
  createdAt           DateTime  @default(now())               @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  userRoles UserRole[]

  @@unique([tenantId, email], map: "idx_users_tenant_email")
  @@index([tenantId], map: "idx_users_tenant")
  @@map("users")
  @@schema("identity")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
  @@schema("identity")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions              RolePermission[]
  // GD-M37-1 Decision 8: ElevationSessionCapability.permissionId is a real FK
  // into this table (referential integrity against the live M36 catalog), not
  // an uncontrolled string. Additive back-relation only — no other field on
  // this model is touched.
  elevationSessionCapabilities ElevationSessionCapability[]
  // GD-M38-1 Decision 11: ApprovalRequirement.requiredCapabilityId is a real
  // FK into this table for ACTION_AUTHORITY requirements (referential
  // integrity against the live M36 catalog). Additive back-relation only.
  approvalRequirements         ApprovalRequirement[]

  @@unique([resource, action])
  @@map("permissions")
  @@schema("identity")
}

// Role → Permission assignment (many-to-many)
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("identity")
}

// User → Role assignment (many-to-many)
model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// Governance authority: governance/GD-M37-1.md (M37 — Elevation Sessions
// Foundation). Internal-service-only data model for time-bounded,
// per-capability access elevation requests. No HTTP surface, no runtime
// authorization effect — RolesGuard remains the sole runtime authorization
// authority; nothing in this schema is read by any guard, strategy, or
// controller (GD-M37-1 Decision 17).
//
// "Lifecycle-active" vs "authorization-effective" (GD-M37-1 Decision 20): an
// ACTIVE ElevationSession row is a modeled data fact only. It never grants
// real access by itself — no reader/consumer of these tables exists in M37.
//
// These are the FIRST native Postgres enums in this schema (every other
// "status"-like field in this file uses String @db.VarChar(50) governed at
// the service layer). GD-M37-1 Decision 5 explicitly and deliberately
// departs from that convention for elevation lifecycle/decision states —
// this is a governance-authorized exception, not an inconsistency to fix.
// ---------------------------------------------------------------------------

// GD-M37-1 Decision 6 — exact permitted transitions (see ElevationSession
// below); every other transition must be rejected by the service layer.
enum ElevationSessionStatus {
  REQUESTED
  APPROVED
  DENIED
  CANCELLED
  ACTIVE
  EXPIRED
  REVOKED
  ACTIVATION_FAILED

  @@schema("identity")
}

// GD-M37-1 Decision 8 — starts PENDING at request-submission time; becomes
// immutable once the parent ElevationSession leaves REQUESTED.
enum ElevationCapabilityDecision {
  PENDING
  GRANTED
  DENIED

  @@schema("identity")
}

// GD-M38-1 Decision 15 — M37 scope-extension enum. TENANT is the default,
// backward-compatible value for every existing (and newly created,
// unless explicitly scoped) ElevationSession row.
enum ElevationSessionScopeType {
  TENANT
  DEPARTMENT
  DECISION_CASE

  @@schema("identity")
}

// GD-M37-1 Decision 8 — normalized elevation-request data model.
//
// tenantId is a bare scalar with NO Prisma relation to Tenant (matching the
// dominant convention used by Position/Vacancy/Employee/Candidate/Application/
// Interview/Offer/Skill/Certification — isolation enforced at query level,
// SEC-003 — rather than User/Department's minority relation pattern), so that
// no cascade path from Tenant can ever reach this security-relevant table.
//
// requestedByUserId / granteeUserId / approvedByUserId / revokedByUserId are
// plain UUID columns with NO Prisma relation to User at all (GD-M37-1
// Decision 15), mirroring AuditEvent's own documented precedent above:
// "tenantId/userId are plain UUID columns with no Prisma relations —
// cascading deletes must never affect audit records." No implementation may
// add onDelete: Cascade on any actor-reference column, under any
// circumstance.
//
// Approver-separation (approvedByUserId must differ from both
// requestedByUserId and granteeUserId) and grantee/requester equality
// (permitted — self-request is the ordinary case) are enforced at the
// service layer (GD-M37-1 Decision 9); a defense-in-depth DB CHECK
// constraint is added in the migration SQL.
model ElevationSession {
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  requestedByUserId String                 @map("requested_by_user_id") @db.Uuid
  granteeUserId     String                 @map("grantee_user_id") @db.Uuid
  approvedByUserId  String?                @map("approved_by_user_id") @db.Uuid
  revokedByUserId   String?                @map("revoked_by_user_id") @db.Uuid
  status            ElevationSessionStatus @default(REQUESTED)
  purpose           String                 @db.Text
  requestedAt       DateTime               @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt         DateTime?              @map("decided_at") @db.Timestamptz(6)
  activatedAt       DateTime?              @map("activated_at") @db.Timestamptz(6)
  // Mandatory once ACTIVE, never indefinite (GD-M37-1 Decision 8 / 11).
  // Nullable here only because it is unset before activation.
  expiresAt         DateTime?              @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?              @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?                @map("revoked_reason") @db.Text
  denialReason      String?                @map("denial_reason") @db.Text
  // Must remain null throughout M37 (GD-M37-1 Decision 16) — no genuine
  // step-up mechanism exists yet. Never accepted as client input.
  stepUpAuthMethod  String?                @map("step_up_auth_method") @db.VarChar(50)
  stepUpVerifiedAt  DateTime?              @map("step_up_verified_at") @db.Timestamptz(6)
  // Reserved for future correlation; unconsumed by any code in M37.
  correlationId     String?                @map("correlation_id") @db.Uuid
  // Unique WITHIN tenantId only (compound constraint below) — never globally
  // unique (GD-M37-1 Decision 13).
  idempotencyKey    String                 @map("idempotency_key") @db.VarChar(255)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ---------------------------------------------------------------------
  // GD-M38-1 Decision 15 — additive M37 scope extension. decisionCaseId is
  // a plain, no-FK correlation reference (mirrors every other actor/
  // reference column above — never a cascading-delete-capable FK to a
  // security-history-adjacent entity). scopeDepartmentId/scopeDecisionCaseId
  // are real, restrictive (no onDelete clause) FKs, following the exact
  // Position.department/Employee.department cross-schema-relation
  // precedent. These fields remain entirely authorization-inert: no
  // runtime path reads them, and isElevationLifecycleCapabilityValidAt()
  // is unmodified by their addition.
  // ---------------------------------------------------------------------
  decisionCaseId      String?                   @map("decision_case_id") @db.Uuid
  scopeType           ElevationSessionScopeType @default(TENANT) @map("scope_type")
  scopeDepartmentId   String?                   @map("scope_department_id") @db.Uuid
  scopeDecisionCaseId String?                   @map("scope_decision_case_id") @db.Uuid

  capabilities      ElevationSessionCapability[]
  scopeDepartment   Department?                  @relation(fields: [scopeDepartmentId], references: [id])
  scopeDecisionCase DecisionCase?                @relation(fields: [scopeDecisionCaseId], references: [id])

  @@unique([tenantId, idempotencyKey], map: "idx_elevation_sessions_tenant_idempotency")
  @@index([tenantId, granteeUserId], map: "idx_elevation_sessions_tenant_grantee")
  @@index([tenantId, status], map: "idx_elevation_sessions_tenant_status")
  @@index([scopeDepartmentId], map: "idx_elevation_sessions_scope_department")
  @@index([scopeDecisionCaseId], map: "idx_elevation_sessions_scope_decision_case")
  // GD-M37-1 Decision 13 — "at most one non-terminal session (REQUESTED /
  // APPROVED / ACTIVE) per (tenantId, granteeUserId)" is a PARTIAL UNIQUE
  // INDEX with a WHERE clause, which Prisma's @@unique cannot express.
  // DO NOT add @@unique([tenantId, granteeUserId]) here — it lives in
  // migration SQL only. See the m37_elevation_sessions migration (follows
  // the same idiom as Offer's "one active offer per application" partial
  // index at apps/api/prisma/migrations/20260630100000_m18b_offers).
  // GD-M38-1 Decision 15 — the scope-consistency CHECK constraint
  // (scopeType vs. scopeDepartmentId/scopeDecisionCaseId nullability, and
  // the DECISION_CASE-scope-must-match-decisionCaseId rule) also lives in
  // migration SQL only — Prisma has no cross-column conditional CHECK
  // syntax. DO NOT assume these invariants are enforced by this schema
  // file alone; see the m38 migration and the service-layer validation in
  // ElevationSessionService.
  @@map("elevation_sessions")
  @@schema("identity")
}

// GD-M37-1 Decision 8 — one row per requested capability item. All rows for
// a session are created together at request-submission time, all starting
// PENDING; no row is ever created afterward, and no row's decision may
// remain PENDING once the parent session leaves REQUESTED. The "granted
// capability set" is always DERIVED (the distinct Permission set where
// decision = GRANTED) — never a separate writable field.
model ElevationSessionCapability {
  id                 String                      @id @default(uuid()) @db.Uuid
  elevationSessionId String                      @map("elevation_session_id") @db.Uuid
  permissionId       String                      @map("permission_id") @db.Uuid
  decision           ElevationCapabilityDecision @default(PENDING)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  elevationSession ElevationSession @relation(fields: [elevationSessionId], references: [id])
  permission       Permission       @relation(fields: [permissionId], references: [id])

  // Each Permission may appear at most once per session (GD-M37-1 Decision 8).
  @@unique([elevationSessionId, permissionId], map: "idx_elevation_session_capabilities_session_permission")
  @@index([elevationSessionId], map: "idx_elevation_session_capabilities_session")
  @@map("elevation_session_capabilities")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// Schema: decisions
// Governance authority: governance/GD-M38-1.md (M38 — Decision Case and
// Approval Foundation). Internal-service-only, dormant, deterministic
// foundation for tiered human approval of consequential decisions. No HTTP
// surface, no runtime authorization or business-execution effect — an
// APPROVED DecisionCase has zero effect on any existing endpoint or
// business action (GD-M38-1 Decision 4). RolesGuard remains the sole
// runtime authorization authority; nothing in this schema is read by any
// guard, strategy, or controller.
//
// ApprovalRequirement and ApprovalDecision are deliberately SEPARATE
// entities (GD-M38-1 Decision 9), not one mutable row: a requirement is an
// immutable approval slot created when its parent ApprovalRequest is
// created; a decision is created only when a human acts, is append-only,
// and is immutable from creation. This is a deliberate departure from
// ElevationSessionCapability's single-mutable-row idiom (M38's decisions
// carry more audit-significant detail per event and must never be edited
// in place, even before a terminal state is reached).
//
// PolicyEvaluation, ActionExecution, VerificationResult, AIRecommendation,
// and AgentRun are explicitly deferred (GD-M38-1 Decision 5) — no table,
// no placeholder, no dangling reference column for any of the five exists
// anywhere in this schema.
// ---------------------------------------------------------------------------

// GD-M38-1 Decision 7 — exact permitted states; every other transition is
// rejected by the service layer. DETECTED/AI_PREPARED/POLICY_CHECKED/
// EXECUTED/VERIFIED/CLOSED are deliberately NOT implemented (no writer
// exists in M38 for any of them).
enum DecisionCaseStatus {
  OPEN
  AWAITING_APPROVAL
  NEEDS_INFORMATION
  APPROVED
  REJECTED
  CANCELLED

  @@schema("decisions")
}

// GD-M38-1 Decision 8 — one ApprovalRequest represents one complete,
// immutable approval plan for one case version.
enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_INFORMATION
  SUPERSEDED
  CANCELLED

  @@schema("decisions")
}

// GD-M38-1 Decision 9 — allowed ApprovalDecision outcomes. Deliberately
// has NO PENDING value: a decision row is created only when a human acts.
enum ApprovalDecisionValue {
  GRANTED
  REJECTED
  NEEDS_INFORMATION

  @@schema("decisions")
}

// GD-M38-1 Decision 11 — the three approval tiers.
enum ApprovalTier {
  TIER_1
  TIER_2
  TIER_3

  @@schema("decisions")
}

// GD-M38-1 Decision 13 — stable authority categories. Legacy role names are
// never embedded directly into the approval engine's schema; the temporary,
// dormant role-to-category qualification mapping lives in
// apps/api/src/decisions/authority-category-mapping.ts (service layer
// only), never here.
enum AuthorityCategory {
  ACTION_AUTHORITY
  DEPARTMENT_OR_HIRING_AUTHORITY
  HR_AUTHORITY
  INDEPENDENT_OVERSIGHT_REVIEWER

  @@schema("decisions")
}

// GD-M38-1 Decision 6 — governed subject types only, never a free-form
// string. Reused identically for EvidenceItem.sourceType (Decision 14).
// GENERAL requires a null subject/source id; every other value requires a
// non-null one — enforced by the internal subject resolver
// (decision-case-subject-resolver.ts), never by a database FK (a true
// polymorphic FK spanning multiple, differently-schema'd tables is
// unavailable in this codebase's multiSchema Prisma setup).
enum DecisionCaseSubjectType {
  OFFER
  APPLICATION
  EMPLOYEE
  ELEVATION_SESSION
  GENERAL

  @@schema("decisions")
}

// GD-M38-1 Decision 12 — governed elevated-risk trigger types, directly
// enumerating GD-M35-1 Decision 13's elevated-risk condition list.
// OTHER_EXPLICITLY_CLASSIFIED exists only for a future, explicitly governed
// addition — never a silent catch-all without an accompanying reason.
enum DecisionCaseRiskTriggerType {
  COMPLIANCE_OR_POLICY_EXCEPTION
  FAILED_CONTROL_OVERRIDE
  PRIVILEGED_OR_EMERGENCY_ACCESS
  AUTHORIZATION_POLICY_OR_SECURITY_CONFIGURATION_CHANGE
  SELF_PREPARED_WORKFORCE_PLAN_OR_FORECAST_ACTIVATION
  SENSITIVE_BULK_ACTION
  OTHER_EXPLICITLY_CLASSIFIED

  @@schema("decisions")
}

// GD-M38-1 Decision 14 — governed evidence types.
enum EvidenceType {
  SOURCE_RECORD_REFERENCE
  HUMAN_NOTE
  SYSTEM_DERIVED_SUMMARY

  @@schema("decisions")
}

// GD-M38-1 Decision 14 — governed evidence sensitivity classifications.
enum EvidenceSensitivityClassification {
  USER_ACCOUNT_IDENTITY
  EMPLOYEE_CANDIDATE_PII
  AGGREGATE_EXECUTIVE
  COMPLIANCE_SENSITIVE
  PRIVILEGED_ACCESS_EVIDENCE

  @@schema("decisions")
}

// GD-M38-1 Decision 14 — exactly two provenance values; never AI. Reused
// identically for DecisionCaseRiskTrigger.sourceOrProvenance (Decision 12
// explicitly reuses "Decision 14's provenance categories").
// DETERMINISTIC_SYSTEM describes exactly what M38 itself, or a future
// deterministic service (e.g. M42's Policy Guard), produces — it is never
// relabeled AI regardless of how sophisticated the deterministic logic
// becomes (GD-M38-1 Decision 20).
enum ProvenanceType {
  HUMAN
  DETERMINISTIC_SYSTEM

  @@schema("decisions")
}

// GD-M38-1 Decision 6 / Appendix A — the case itself. tenantId is a bare
// scalar (dominant convention). initiatedByUserId/preparedByUserId are
// plain UUID columns with NO Prisma relation to User (actor-reference
// idiom, GD-M37-1 Decision 15 precedent) — these are security-relevant
// history rows whose integrity must never depend on User deletion
// behavior. subjectId is likewise a plain UUID with no FK — see the enum
// comment above. The GENERAL-requires-null / other-requires-non-null
// invariant is enforced by a CHECK constraint in migration SQL only (no
// Prisma cross-column conditional CHECK syntax exists) AND by the
// service-layer subject resolver — never by one alone.
model DecisionCase {
  id                String                  @id @default(uuid()) @db.Uuid
  tenantId          String                  @map("tenant_id") @db.Uuid
  subjectType       DecisionCaseSubjectType @map("subject_type")
  subjectId         String?                 @map("subject_id") @db.Uuid
  initiatedByUserId String                  @map("initiated_by_user_id") @db.Uuid
  preparedByUserId  String                  @map("prepared_by_user_id") @db.Uuid
  purpose           String                  @db.Text
  status            DecisionCaseStatus      @default(OPEN)
  // Optional, unique WITHIN tenantId only (compound constraint below) —
  // never globally unique (GD-M38-1 Decision 16, mirroring GD-M37-1
  // Decision 13's identical idiom for ElevationSession.idempotencyKey).
  idempotencyKey    String?                 @map("idempotency_key") @db.VarChar(255)
  // Optimistic concurrency (GD-M38-1 Decision 16) — every mutating service
  // call must match the version it read, or fail with a specific
  // stale-version outcome; never a silent overwrite.
  version           Int                     @default(1)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  evidenceItems           EvidenceItem[]
  riskTriggers            DecisionCaseRiskTrigger[]
  approvalRequests        ApprovalRequest[]
  scopedElevationSessions ElevationSession[]

  @@unique([tenantId, idempotencyKey], map: "idx_decision_cases_tenant_idempotency")
  @@index([tenantId, status], map: "idx_decision_cases_tenant_status")
  @@index([tenantId, subjectType, subjectId], map: "idx_decision_cases_tenant_subject")
  // GD-M38-1 Decision 6 — CHECK constraint (subjectType = 'GENERAL' implies
  // subject_id IS NULL; every other subjectType implies subject_id IS NOT
  // NULL) lives in migration SQL only. See the m38 migration.
  @@map("decision_cases")
  @@schema("decisions")
}

// GD-M38-1 Decision 14 — append-only, case-scoped evidence reference. Never
// a copy of the full source record; never an uncontrolled JSON blob.
// sourceType/sourceId reuse DecisionCaseSubjectType's governed-enum-plus-
// UUID, no-FK, service-resolved pattern. producedByUserId is a plain UUID
// with no FK, populated only when provenanceType = HUMAN — a
// DETERMINISTIC_SYSTEM-provenance item's absent producedByUserId must
// never be reused as a human approver (GD-M38-1 Decision 14/17).
model EvidenceItem {
  id                        String                            @id @default(uuid()) @db.Uuid
  tenantId                  String                            @map("tenant_id") @db.Uuid
  decisionCaseId            String                            @map("decision_case_id") @db.Uuid
  evidenceType              EvidenceType                      @map("evidence_type")
  sensitivityClassification EvidenceSensitivityClassification @map("sensitivity_classification")
  sourceType                DecisionCaseSubjectType           @map("source_type")
  sourceId                  String?                           @map("source_id") @db.Uuid
  provenanceType            ProvenanceType                    @map("provenance_type")
  producedByUserId          String?                           @map("produced_by_user_id") @db.Uuid
  capturedAt                DateTime                          @map("captured_at") @db.Timestamptz(6)
  // PII-minimized/redacted text only — never a copy of the full source
  // record (GD-M38-1 Decision 14).
  summary                   String?                           @db.Text
  // Optional integrity/version metadata where the source supports it (e.g.
  // a source record's updatedAt at capture time) — free text, not a raw
  // payload copy.
  integrityMetadata         String?                           @map("integrity_metadata") @db.Text
  createdAt                 DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)

  decisionCase       DecisionCase              @relation(fields: [decisionCaseId], references: [id])
  approvalRequestUse ApprovalRequestEvidence[]

  @@index([tenantId, decisionCaseId], map: "idx_evidence_items_tenant_case")
  // GD-M38-1 Decision 6 (reused) — CHECK constraint (sourceType = 'GENERAL'
  // implies source_id IS NULL; every other sourceType implies source_id IS
  // NOT NULL) lives in migration SQL only.
  @@map("evidence_items")
  @@schema("decisions")
}

// GD-M38-1 Decision 12 — normalized, append-only elevated-risk trigger
// records. Never a single requiresTier3 boolean. Supplied only through the
// internal deterministic service, for modeling and testing — M38 performs
// no automatic detection (M42 owns that).
model DecisionCaseRiskTrigger {
  id                     String                      @id @default(uuid()) @db.Uuid
  tenantId               String                      @map("tenant_id") @db.Uuid
  decisionCaseId         String                      @map("decision_case_id") @db.Uuid
  triggerType            DecisionCaseRiskTriggerType @map("trigger_type")
  reason                 String                      @db.Text
  sourceOrProvenance     ProvenanceType              @map("source_or_provenance")
  // Nullable, no FK (actor-reference idiom); null only when
  // sourceOrProvenance = DETERMINISTIC_SYSTEM and no human actor applies.
  createdByUserId        String?                     @map("created_by_user_id") @db.Uuid
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  // Which ApprovalRequest version this trigger applied to (or preceded, if
  // it caused a new version) — a plain integer snapshot, not a live FK, so
  // this row's historical meaning survives request supersession.
  caseVersion            Int                         @map("case_version")
  includedInApprovalPlan Boolean                     @default(false) @map("included_in_approval_plan")

  decisionCase DecisionCase @relation(fields: [decisionCaseId], references: [id])

  @@index([tenantId, decisionCaseId], map: "idx_decision_case_risk_triggers_tenant_case")
  @@map("decision_case_risk_triggers")
  @@schema("decisions")
}

// GD-M38-1 Decision 8 — one complete, immutable approval plan per case
// version. Only one PENDING request may exist per case at any time
// (partial unique index, migration SQL only — see the m38 migration,
// reusing the Offer/ElevationSession idiom a third time). The version
// chain (version + supersedesRequestId) makes supersession and
// resubmission explicit and auditable.
model ApprovalRequest {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  decisionCaseId      String                @map("decision_case_id") @db.Uuid
  version             Int
  supersedesRequestId String?               @map("supersedes_request_id") @db.Uuid
  status              ApprovalRequestStatus @default(PENDING)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt           DateTime?             @map("decided_at") @db.Timestamptz(6)

  decisionCase DecisionCase              @relation(fields: [decisionCaseId], references: [id])
  supersedes   ApprovalRequest?          @relation("ApprovalRequestSupersession", fields: [supersedesRequestId], references: [id])
  supersededBy ApprovalRequest[]         @relation("ApprovalRequestSupersession")
  requirements ApprovalRequirement[]
  evidenceUse  ApprovalRequestEvidence[]
  decisions    ApprovalDecision[]

  // Monotonically increasing version per case (GD-M38-1 Decision 16).
  @@unique([decisionCaseId, version], map: "idx_approval_requests_case_version")
  @@index([tenantId, decisionCaseId], map: "idx_approval_requests_tenant_case")
  // GD-M38-1 Decision 16 — "at most one active PENDING ApprovalRequest per
  // DecisionCase" is a PARTIAL UNIQUE INDEX with a WHERE clause, which
  // Prisma's @@unique cannot express. DO NOT add
  // @@unique([tenantId, decisionCaseId]) here — it lives in migration SQL
  // only. See the m38 migration.
  @@map("approval_requests")
  @@schema("decisions")
}

// GD-M38-1 Decision 9 — an immutable approval slot, created in full when
// its parent ApprovalRequest is created (never created afterward). May
// remain unanswered; is never itself a decision. Rows are never updated
// after creation.
model ApprovalRequirement {
  id                        String            @id @default(uuid()) @db.Uuid
  approvalRequestId         String            @map("approval_request_id") @db.Uuid
  requiredAuthorityCategory AuthorityCategory @map("required_authority_category")
  // Populated only for ACTION_AUTHORITY requirements (Decision 11). Real
  // FK into the live M36 Permission catalog — never an uncontrolled string.
  requiredCapabilityId      String?           @map("required_capability_id") @db.Uuid
  // Nullable ordering hint, unconsumed by any M38 ordering logic beyond
  // display/audit purposes (Decision 9 — reserved for a future tier design
  // that requires sequential, not merely parallel, satisfaction).
  sequenceOrder             Int?              @map("sequence_order")
  tier                      ApprovalTier
  createdAt                 DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  approvalRequest    ApprovalRequest   @relation(fields: [approvalRequestId], references: [id])
  requiredCapability Permission?       @relation(fields: [requiredCapabilityId], references: [id])
  decision           ApprovalDecision?

  // A request cannot declare the same authority category twice
  // (GD-M38-1 Decision 16).
  @@unique([approvalRequestId, requiredAuthorityCategory], map: "idx_approval_requirements_request_category")
  @@index([approvalRequestId], map: "idx_approval_requirements_request")
  @@map("approval_requirements")
  @@schema("decisions")
}

// GD-M38-1 Decision 9 — created only when a human acts. Append-only and
// immutable from the moment it is created; no service method may update an
// existing decision row, under any circumstance. Has NO PENDING value.
// approvalRequestId is a deliberate, documented denormalization of
// approvalRequirement.approvalRequestId — required so that the
// one-human-cannot-satisfy-multiple-requirements-on-one-request constraint
// (Decision 16) can be expressed as a single flat unique index; the
// service layer must always set it equal to the parent requirement's own
// approvalRequestId.
model ApprovalDecision {
  id                    String                @id @default(uuid()) @db.Uuid
  approvalRequirementId String                @unique @map("approval_requirement_id") @db.Uuid
  approvalRequestId     String                @map("approval_request_id") @db.Uuid
  // The deciding human — plain UUID, no FK (actor-reference idiom,
  // GD-M37-1 Decision 15 precedent). Never a service-actor sentinel
  // (GD-M38-1 Decision 10/17) — validated at the service layer via the
  // same assertActorInTenant-style check GD-M37-1 established.
  decidedByUserId       String                @map("decided_by_user_id") @db.Uuid
  decision              ApprovalDecisionValue
  reason                String                @db.Text
  // Immutable text capture of what qualified this actor at decision time
  // (e.g. the qualifying role name and/or capability key) — so historical
  // meaning survives later role or profile migration (GD-M38-1 Decision 13).
  qualificationSnapshot String                @map("qualification_snapshot") @db.Text
  // A plain integer snapshot of the parent ApprovalRequest's own version at
  // decision time — the exact ApprovalRequestEvidence freeze considered
  // (GD-M38-1 Decision 14), not a live join.
  evidenceSetVersion    Int                   @map("evidence_set_version")
  decidedAt             DateTime              @default(now()) @map("decided_at") @db.Timestamptz(6)

  approvalRequirement ApprovalRequirement @relation(fields: [approvalRequirementId], references: [id])
  approvalRequest     ApprovalRequest     @relation(fields: [approvalRequestId], references: [id])

  // One person cannot satisfy multiple requirements on the same request
  // (GD-M38-1 Decision 16) — expressible as a plain Prisma @@unique because
  // decidedByUserId is mandatory (never null) on this model, unlike M37's
  // optional revokedByUserId-style columns.
  @@unique([approvalRequestId, decidedByUserId], map: "idx_approval_decisions_request_decider")
  @@index([approvalRequestId], map: "idx_approval_decisions_request")
  @@map("approval_decisions")
  @@schema("decisions")
}

// GD-M38-1 Decision 14 — a normalized join that FREEZES the exact evidence
// set presented for one specific ApprovalRequest version. Follows the
// existing RolePermission/UserRole composite-primary-key join-table idiom
// (no synthetic id) rather than ElevationSessionCapability's synthetic-id
// child-row idiom, since this is a pure many-to-many association, not an
// entity with its own decision lifecycle.
model ApprovalRequestEvidence {
  approvalRequestId String   @map("approval_request_id") @db.Uuid
  evidenceItemId    String   @map("evidence_item_id") @db.Uuid
  includedAt        DateTime @default(now()) @map("included_at") @db.Timestamptz(6)

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id])
  evidenceItem    EvidenceItem    @relation(fields: [evidenceItemId], references: [id])

  @@id([approvalRequestId, evidenceItemId])
  @@map("approval_request_evidence")
  @@schema("decisions")
}

// ---------------------------------------------------------------------------
// Schema: recruiting — Candidate
// Governance authority: GD-PRE-PHASE3-002 Decision 3 (canonical schema authority)
//                       GD-M16-1 Decision 4 (schema scope for M16)
// Milestone 16: Candidate Management Foundation (FR-300 partial)
// Approved decisions:
//   - tenantId bare scalar — isolation enforced at query level (SEC-003; GD-PRE-PHASE3-002 D1)
//   - tenantId derived from JWT only; never from request body; never in API responses
//   - status VARCHAR(50) default ACTIVE; values: ACTIVE, ARCHIVED
//     Only ACTIVE → ARCHIVED transition allowed; archive endpoint only
//   - deleted_at per platform soft-delete convention (GD-PRE-PHASE3-002 D2)
//   - EMAIL UNIQUENESS: enforced as partial unique index in migration SQL
//     (WHERE deleted_at IS NULL) to allow re-applicant scenario (GD-M16-1 D5).
//     DO NOT add @@unique([tenantId, email]) — Prisma would generate a full
//     non-partial unique constraint, blocking re-applicants whose prior record
//     is archived. Uniqueness is @@index here; partial UNIQUE enforced in SQL.
// ---------------------------------------------------------------------------

model Candidate {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  firstName String    @map("first_name") @db.VarChar(100)
  lastName  String    @map("last_name") @db.VarChar(100)
  email     String    @db.VarChar(255)
  phone     String?   @db.VarChar(50)
  status    String    @default("ACTIVE") @db.VarChar(50)
  source    String?   @db.VarChar(100)
  notes     String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  applications Application[]

  @@index([tenantId], map: "idx_candidates_tenant")
  @@index([tenantId, status], map: "idx_candidates_tenant_status")
  // Partial UNIQUE index on (tenant_id, email) WHERE deleted_at IS NULL lives in
  // migration SQL only — see 20260627000000_m16_recruiting_candidates/migration.sql.
  // Do NOT change to @@unique (GD-M16-1 Decision 5).
  @@index([tenantId, email], map: "idx_candidates_tenant_email")
  @@map("candidates")
  @@schema("recruiting")
}

// ---------------------------------------------------------------------------
// Schema: recruiting — Application
// Governance authority: GD-M17-1 (2026-06-29)
// Milestone 17: Application Management Foundation
// Approved decisions:
//   - tenantId bare scalar — isolation enforced at query level (SEC-003; GD-M17-1 D15)
//   - tenantId derived from JWT only; never from request body; never in API responses
//   - status VARCHAR(50) default APPLIED; canonical values: APPLIED/SCREENING/INTERVIEW/
//     EVALUATION/OFFER/HIRED/REJECTED/WITHDRAWN (GD-PRE-PHASE3-002 D8; GD-M17-1 D5)
//   - DUPLICATE PREVENTION: enforced as partial unique index in migration SQL
//     (tenant_id, candidate_id, vacancy_id WHERE deleted_at IS NULL
//     AND status NOT IN ('REJECTED', 'WITHDRAWN')) — allows re-application after
//     terminal states (GD-M17-1 Decision 5, Decision 7).
//     DO NOT add @@unique([tenantId, candidateId, vacancyId]) — would generate a
//     full non-partial unique constraint blocking terminal re-application.
//   - Relations to Candidate and Vacancy are one-directional by intent;
//     back-relations on Candidate and Vacancy are added solely for Prisma schema
//     validation — not exposed through service APIs.
//   - interviews Interview[] back-relation added in M18A solely for Prisma schema
//     validation — not consumed by ApplicationService (GD-M18-1 D4).
//   - offers Offer[] back-relation added in M18B solely for Prisma schema
//     validation — OfferService queries the offers table directly (GD-M18-1 D6).
//   - deleted_at per platform soft-delete convention
// ---------------------------------------------------------------------------

model Application {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  candidateId  String    @map("candidate_id") @db.Uuid
  vacancyId    String    @map("vacancy_id") @db.Uuid
  status       String    @default("APPLIED") @db.VarChar(50)
  submittedAt  DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  currentStage String?   @map("current_stage") @db.VarChar(100)
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  candidate  Candidate   @relation(fields: [candidateId], references: [id])
  vacancy    Vacancy     @relation(fields: [vacancyId], references: [id], map: "fk_application_vacancy")
  interviews Interview[]
  offers     Offer[]

  @@index([tenantId], map: "idx_applications_tenant")
  @@index([tenantId, candidateId], map: "idx_applications_candidate")
  @@index([tenantId, vacancyId], map: "idx_applications_vacancy")
  @@index([tenantId, status], map: "idx_applications_status")
  // Partial UNIQUE index on (tenant_id, candidate_id, vacancy_id)
  // WHERE deleted_at IS NULL AND status NOT IN ('REJECTED', 'WITHDRAWN')
  // lives in migration SQL only — prevents duplicate active applications while
  // allowing re-application after terminal states (GD-M17-1 Decision 5, Decision 7).
  // Do NOT change to @@unique (would block legitimate re-application).
  // See migration 20260629000000_m17_applications/migration.sql.
  @@map("applications")
  @@schema("recruiting")
}

// ---------------------------------------------------------------------------
// Schema: recruiting — Interview
// Governance authority: GD-M18-1 (2026-06-30)
// Milestone 18A: Interview Management Foundation
// Approved decisions:
//   - tenantId bare scalar — isolation enforced at query level (SEC-003; GD-M18-1 D16)
//   - tenantId derived from JWT only; never from request body; never in API responses
//   - status VARCHAR(50) default SCHEDULED; canonical values: SCHEDULED, COMPLETED,
//     CANCELLED, NO_SHOW (GD-PRE-PHASE3-002 D8; GD-M18-1 D5)
//   - interviewerUserId: nullable; no DB-level FK constraint (GD-PRE-PHASE3-002 D5;
//     GD-M18-1 D4). Service validates user existence and tenant membership at runtime.
//   - Back-relation is on Application (interviews Interview[]) for Prisma schema
//     validation only — not consumed by ApplicationService (GD-M18-1 D4).
//   - deleted_at per platform soft-delete convention
// ---------------------------------------------------------------------------

model Interview {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  applicationId     String    @map("application_id") @db.Uuid
  interviewType     String    @map("interview_type") @db.VarChar(50)
  scheduledAt       DateTime? @map("scheduled_at") @db.Timestamptz(6)
  status            String    @default("SCHEDULED") @db.VarChar(50)
  interviewerName   String?   @map("interviewer_name") @db.VarChar(255)
  interviewerUserId String?   @map("interviewer_user_id") @db.Uuid
  feedback          String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], map: "fk_interview_application")

  @@index([tenantId], map: "idx_interviews_tenant")
  @@index([tenantId, applicationId], map: "idx_interviews_application")
  @@map("interviews")
  @@schema("recruiting")
}

// ---------------------------------------------------------------------------
// Schema: recruiting — Offer
// Governance authority: GD-M18-1 (2026-06-30)
// Milestone 18B: Offer Management Foundation
// Approved decisions:
//   - tenantId bare scalar — isolation enforced at query level (SEC-003; GD-M18-1 D16)
//   - tenantId derived from JWT only; never from request body; never in API responses
//   - status VARCHAR(50) default DRAFT; canonical values: DRAFT, PENDING_APPROVAL,
//     APPROVED, SENT, ACCEPTED, DECLINED, WITHDRAWN (GD-PRE-PHASE3-002 D8; GD-M18-1 D7)
//   - acceptedAt and declinedAt: set by OfferService at the moment of status transition;
//     no withdrawn_at column per GD-M18-1 D7 (updated_at reflects withdrawal time)
//   - Back-relation is on Application (offers Offer[]) for Prisma schema validation only
//     — OfferService queries the offers table directly (GD-M18-1 D6).
//   - Offer acceptance does NOT set application.status to HIRED and does NOT create
//     an employee record — hire-to-employee is M19 scope (GD-M18-1 D3, D9)
//   - Partial UNIQUE index idx_offers_application_active lives in migration SQL only
//     (cannot be expressed as Prisma @@unique — would generate a non-partial constraint).
//     Active = deleted_at IS NULL AND status NOT IN ('DECLINED', 'WITHDRAWN').
//     Re-offer permitted only after DECLINED or WITHDRAWN (GD-M18-1 D6, D10).
//   - deleted_at per platform soft-delete convention
// ---------------------------------------------------------------------------

model Offer {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  status        String    @default("DRAFT") @db.VarChar(50)
  offerDate     DateTime? @map("offer_date") @db.Timestamptz(6)
  acceptedAt    DateTime? @map("accepted_at") @db.Timestamptz(6)
  declinedAt    DateTime? @map("declined_at") @db.Timestamptz(6)
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], map: "fk_offer_application")

  @@index([tenantId], map: "idx_offers_tenant")
  @@index([tenantId, applicationId], map: "idx_offers_application")
  // Partial UNIQUE index on (application_id) WHERE deleted_at IS NULL AND status NOT IN ('DECLINED', 'WITHDRAWN')
  // lives in migration SQL only — enforces one active offer per application; re-offer allowed after
  // DECLINED or WITHDRAWN terminal states (GD-M18-1 D6, D10). Do NOT add @@unique here.
  // See migration 20260630100000_m18b_offers/migration.sql.
  @@map("offers")
  @@schema("recruiting")
}

// ---------------------------------------------------------------------------
// Schema: audit
// Append-only immutable audit trail. tenantId/userId are plain UUID columns
// with no Prisma relations — cascading deletes must never affect audit records.
// Spec reference: spec/05_database_schema.md — Schema: audit / audit_events
// ---------------------------------------------------------------------------

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  entityType String?  @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Uuid
  action     String   @db.VarChar(100)
  result     String   @default("SUCCESS") @db.VarChar(50)
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // ---------------------------------------------------------------------
  // GD-M39-1 Decisions 5-6, 8-9 — additive M39 fields. occurredAt/
  // retentionUntil are NOT NULL here because this reflects final schema
  // state; the m39 migration adds them nullable, backfills every existing
  // row, then sets NOT NULL (Decision 6's exact 5-step sequence) before
  // installing the retention-derivation trigger. sequenceNo/recordHash/
  // previousHash/hashVersion remain nullable permanently — legacy
  // pre-chain rows never receive fabricated values (Decision 8).
  // ---------------------------------------------------------------------
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  retentionUntil DateTime @map("retention_until") @db.Timestamptz(6)
  sequenceNo     BigInt?  @map("sequence_no")
  recordHash     String?  @map("record_hash") @db.VarChar(64)
  previousHash   String?  @map("previous_hash") @db.VarChar(64)
  hashVersion    String?  @map("hash_version") @db.VarChar(20)

  @@index([tenantId], map: "idx_audit_tenant")
  @@index([userId], map: "idx_audit_user")
  @@index([createdAt], map: "idx_audit_created")
  // GD-M39-1 Decision 10, indexes 1-4.
  @@index([tenantId, entityType, entityId], map: "idx_audit_events_tenant_entity")
  @@index([tenantId, action], map: "idx_audit_events_tenant_action")
  @@index([tenantId, occurredAt], map: "idx_audit_events_tenant_occurred_at")
  @@unique([tenantId, sequenceNo], map: "idx_audit_events_tenant_sequence")
  @@map("audit_events")
  @@schema("audit")
}

// ---------------------------------------------------------------------------
// Schema: audit — M39 Audit Read, Recovery, and Integrity Foundation
// Reference: governance/GD-M39-1.md — Decisions 6-13 (retention, append-only
// trigger, hash chain, additive data model, indexes, recovery, workers)
//
// Three additive tables, all within the existing "audit" schema (no new
// schema created). AuditWriteFailure/AuditWriteFailureAttempt/
// AuditChainState carry a bare-scalar tenantId column, enforced at the
// service layer exactly as every existing table in this codebase — no
// cross-tenant read or write path is authorized for any of the three
// (Decision 9). AuditWriteFailure and AuditChainState remain ordinary
// mutable operational tables by design; only AuditWriteFailureAttempt's
// terminal (SUCCEEDED/FAILED) rows are immutable, by service-layer
// convention (Decision 9/12) — none of the three is covered by Decision 7's
// append-only trigger, which applies only to audit_events.
// ---------------------------------------------------------------------------

enum AuditWriteFailureStatus {
  PENDING
  IN_PROGRESS
  RETRIED
  ABANDONED

  @@schema("audit")
}

enum AuditWriteFailureAttemptStatus {
  IN_PROGRESS
  SUCCEEDED
  FAILED

  @@schema("audit")
}

enum AuditChainVerificationResult {
  OK
  BROKEN

  @@schema("audit")
}

// GD-M39-1 Decision 9 — one row per originally-failed logEvent() attempt.
// id is the eventual AuditEvent.id (client-generated at first failure) —
// never a separate synthetic key — so a successful replay's ON CONFLICT DO
// NOTHING insert targets the exact same row the caller would have written
// on first-attempt success (Decision 11's idempotency guarantee).
// userId/entityType/entityId carry NO FK, mirroring AuditEvent's own
// FK-free actor/resource columns (cascading deletes must never corrupt
// recoverable audit history, same rationale as AuditService's
// SYSTEM_USER_ID/SYSTEM_TENANT_ID sentinels).
model AuditWriteFailure {
  id            String                  @id @db.Uuid
  tenantId      String                  @map("tenant_id") @db.Uuid
  userId        String                  @map("user_id") @db.Uuid
  action        String                  @db.VarChar(100)
  entityType    String?                 @map("entity_type") @db.VarChar(100)
  entityId      String?                 @map("entity_id") @db.Uuid
  result        String                  @db.VarChar(50)
  metadata      Json?                   @db.JsonB
  occurredAt    DateTime                @map("occurred_at") @db.Timestamptz(6)
  // Sanitized, fixed vocabulary only — never a raw DB driver error
  // (Decision 9/12).
  failureReason String                  @map("failure_reason") @db.VarChar(100)
  status        AuditWriteFailureStatus @default(PENDING)
  attemptCount  Int                     @default(0) @map("attempt_count")
  nextAttemptAt DateTime                @map("next_attempt_at") @db.Timestamptz(6)
  claimedAt     DateTime?               @map("claimed_at") @db.Timestamptz(6)
  claimedBy     String?                 @map("claimed_by") @db.VarChar(100)
  attemptedAt   DateTime?               @map("attempted_at") @db.Timestamptz(6)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempts AuditWriteFailureAttempt[]

  // GD-M39-1 Decision 10, index 5 — supports the recovery worker's
  // due-work claiming query (status + nextAttemptAt) and stale-claim
  // detection (claimedAt).
  @@index([status, nextAttemptAt, claimedAt], map: "idx_audit_write_failure_claim")
  // GD-M39-1 Decision 10, index 6 — tenant-scoped recovery summaries.
  @@index([tenantId, status], map: "idx_audit_write_failure_tenant_status")
  @@map("audit_write_failures")
  @@schema("audit")
}

// GD-M39-1 Decision 9/12 — one row per automatic recovery attempt. Terminal
// rows (SUCCEEDED/FAILED) are immutable and never deleted, by service-layer
// convention — no update path is authorized past a terminal status.
model AuditWriteFailureAttempt {
  id                String                          @id @default(uuid()) @db.Uuid
  tenantId          String                          @map("tenant_id") @db.Uuid
  auditWriteFailureId String                        @map("audit_write_failure_id") @db.Uuid
  attemptNumber     Int                             @map("attempt_number")
  claimedBy         String                          @map("claimed_by") @db.VarChar(100)
  startedAt         DateTime                        @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?                       @map("completed_at") @db.Timestamptz(6)
  // Sanitized, fixed vocabulary only — never a raw DB driver error
  // (Decision 12). WORKER_TIMEOUT is the governed value for a
  // claim-expiry closure of a crashed worker's stale IN_PROGRESS attempt.
  failureCategory   String?                         @map("failure_category") @db.VarChar(100)
  status            AuditWriteFailureAttemptStatus  @default(IN_PROGRESS)

  auditWriteFailure AuditWriteFailure @relation(fields: [auditWriteFailureId], references: [id])

  // GD-M39-1 Decision 10, index 7.
  @@unique([auditWriteFailureId, attemptNumber], map: "idx_audit_write_failure_attempt_number")
  // GD-M39-1 Decision 10, index 8.
  @@index([tenantId, auditWriteFailureId], map: "idx_audit_write_failure_attempt_tenant_failure")
  @@map("audit_write_failure_attempts")
  @@schema("audit")
}

// GD-M39-1 Decision 8/13 — one row per tenant; the chain pointer and
// verification-scheduling state. lastVerificationResult is nullable before
// the first verification ever runs for a tenant (Decision 9); once BROKEN,
// nothing in M39 ever auto-clears it (Decision 13).
model AuditChainState {
  tenantId               String                         @id @map("tenant_id") @db.Uuid
  lastSequence           BigInt                         @default(0) @map("last_sequence")
  lastHash               String?                        @map("last_hash") @db.VarChar(64)
  nextVerificationAt     DateTime                       @default(now()) @map("next_verification_at") @db.Timestamptz(6)
  verificationClaimedAt  DateTime?                       @map("verification_claimed_at") @db.Timestamptz(6)
  lastVerifiedAt         DateTime?                       @map("last_verified_at") @db.Timestamptz(6)
  lastVerificationResult AuditChainVerificationResult?   @map("last_verification_result")
  updatedAt              DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)

  // GD-M39-1 Decision 10, index 9 — supports due-tenant verification claiming.
  @@index([nextVerificationAt], map: "idx_audit_chain_state_next_verification")
  @@map("audit_chain_state")
  @@schema("audit")
}

// ---------------------------------------------------------------------------
// Schema: intelligence
// Reference: governance/GD-M34-1.md — Decisions 14, 15, 16, 17, 18
//
// WorkforceSignalSnapshot is an additive, append-or-update-only historical
// record of Phase 4 intelligence signal computations. It exists ONLY to
// accumulate real computed history for a future, separately-governed
// Workforce Trend Analysis (FR-412) or Demand Forecasting (FR-400)
// milestone. No endpoint reads this table in M34 (GD-M34-1 Decision 18) —
// it is written to and read by nothing except SnapshotWriterService.
//
// scopeId is NOT NULL, defaulting to the zero-UUID sentinel for
// scopeType = 'TENANT' rather than using a nullable column as GD-M34-1
// Decision 15's illustrative snippet showed. This is a deliberate
// implementation-time refinement: PostgreSQL UNIQUE constraints treat every
// NULL as distinct from every other NULL, so a nullable scopeId would
// silently defeat the Decision 17 deduplication guarantee for every
// TENANT-scoped row (the most common case) — concurrent requests could
// each insert a new "unique" NULL-scopeId row instead of colliding on the
// intended daily key. A non-null sentinel makes the compound unique
// constraint enforce the guarantee Decision 17 actually requires.
//
// signalType values written by the current implementation (see
// SnapshotWriterService and its callers): 'VACANCY_RISK',
// 'WORKFORCE_READINESS', 'ATTRITION_RISK' (all three also written with
// scopeType='DEPARTMENT' by DepartmentGapService, one row per non-suppressed
// department, per Decision 16), and four distinct
// 'EXECUTIVE_METRICS_<METRIC>' values — one per independent metric
// (VACANCY_RATE / COVERAGE_RATE / TIME_TO_FILL / HIRING_VELOCITY) rather
// than a single shared 'EXECUTIVE_METRICS' tag, because a shared tag would
// collide on the same dedup key for all four metrics and each write would
// overwrite the previous metric's value instead of preserving all four.
// This is a necessary refinement of Decision 15's illustrative value list,
// documented here per that decision's own instruction that any future
// change to signalType's governed value set be recorded.
model WorkforceSignalSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  signalType     String   @map("signal_type") @db.VarChar(50)
  scopeType      String   @map("scope_type") @db.VarChar(20)
  scopeId        String   @default("00000000-0000-0000-0000-000000000000") @map("scope_id") @db.Uuid
  snapshotDate   DateTime @map("snapshot_date") @db.Date
  score          Decimal? @db.Decimal(6, 2)
  level          String?  @db.VarChar(50)
  confidence     Int      @db.SmallInt
  formulaVersion String   @map("formula_version") @db.VarChar(100)
  computedAt     DateTime @map("computed_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, signalType, scopeType, scopeId, snapshotDate], map: "idx_workforce_signal_snapshots_dedup")
  @@index([tenantId, signalType], map: "idx_workforce_signal_snapshots_tenant_signal")
  @@map("workforce_signal_snapshots")
  @@schema("intelligence")
}
